scn newDurabilityOnEquip

int typeCode

ref actor
ref item

Begin Function { actor, item }
    if eval (IsQuestItem item) ; TODO: Do we really want to skip quest items?
        return
    endif

    let typeCode := GetObjectType item
    if eval (typeCode == 40)
        Call newDurabilitySetWeapon, item
    elseif eval (typeCode == 24)
        Call newDurabilitySetArmor
    endif
End