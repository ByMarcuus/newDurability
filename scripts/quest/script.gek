scn newDurabilityScript

short bDisableDurability

Begin MenuMode 4
    if eval (!GetGameRestarted)
        return
    endif

    if eval (FileExists "config/NewDurability.ini")
        if eval (GetINIFloat "DEBUG:bEnablePrints", "NewDurability.ini")
            DBMode 1, (GetModIndex "NewDurability.esp")
        else
            DBMode 0, (GetModIndex "NewDurability.esp")
        endif

        Player.AuxVarSetFlt "*bDisableDurability", (GetINIFloat "EXTRAS:bDisableDurability", "NewDurability.ini")
        if eval (Player.AuxVarGetFlt "*bDisableDurability")

        endif
    endif
End

Begin GameMode
    if eval (!GetGameLoaded)
        return
    endif

    if eval(!FileExists "config/NewDurability.ini")
        print "'data/config/NewDurability.ini' not found!" ; TODO: Show a message box instead
        return
    endif

    let bDisableDurability := (Player.AuxVarGetFlt "*bDisableDurability")
    if eval (bDisableDurability)
        PrintD "NewDurability: Disabling durability..."
        SetNumericGameSetting "fDamageToArmorPercentage", 0
        SetNumericGameSetting "fDamageToWeaponValue", 0
    endif

    StopQuest newDurabilityQuest
End