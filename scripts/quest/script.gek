scn newDurabilityScript

; Initialization script that intentionally runs on HUDMainMenu (really runs everywhere except GameMode).
; Loads some configurations once.
Begin MenuMode 4
    if eval (!GetGameRestarted)
        return
    endif

    if eval (!FileExists "config/newDurability.ini")
        print "NewDurability: config/newDurability.ini not found!" ; TODO: Show a message box instead
    else
        if eval (GetINIFloat "DEBUG:bEnablePrints", "newDurability.ini")
            DBMode 1, (GetModIndex "NewDurability.esp")
        else
            DBMode 0, (GetModIndex "NewDurability.esp")
        endif

        if eval (GetINIFloat "EXTRAS:bDisableDurability", "newDurability.ini")
            PrintD "NewDurability: Disabling durability..."
            SetNumericGameSetting "fDamageToArmorPercentage", 0
            SetNumericGameSetting "fDamageToWeaponValue", 0
            Player.AuxVarSetFlt "*bDisableDurability", 1
        else
            PrintD "NewDurability: Enabling durability..."
            Player.AuxVarSetFlt "*fWeaponBaseHealth", (Clamp (GetINIFloat "WEAPONS:fWeaponBaseHealth", "newDurability.ini"), 0, 3)
            Player.AuxVarSetFlt "*fArmorBaseHealth", (Clamp (GetINIFloat "WEAPONS:fArmorBaseHealth", "newDurability.ini"), 0, 100) ; TODO: Find a better max value
            Player.AuxVarSetFlt "*fWeaponSkillMult", (Clamp (GetINIFloat "WEAPONS:fWeaponSkillMult", "newDurability.ini"), 0, 3)
            Player.AuxVarSetFlt "*fArmorSkillMult", (Clamp (GetINIFloat "WEAPONS:fArmorSkillMult", "newDurability.ini"), 0, 3)
        endif
    endif
End

; Script that disables OverrideDamageToWeapon Flag
Begin GameMode
    if eval (!GetGameLoaded)
        return
    endif

    PrintD "NewDurality: Disabling 'Override DamageToWeaponMult' Flag..."

    array_var weapons := GetLoadedTypeArray 40
    int index := Ar_Size weapons
    while (index -= 1) >= 0
        ref weapon := weapons[index]

        int playableFlag := GetWeaponFlags1 weapon
        int overrideFlag := GetWeaponFlags2 weapon ; 'Override DamageToWeaponMult' flag
        if eval (GetBit overrideFlag, 7 && !(IsQuestItem weapon) && !(GetBit playableFlag, 7))
            SetWeaponFlags2 weapon, (overrideFlag - 128)
        endif
    loop
    Ar_Erase weapons

    ; FIX: Cannot enable durability after disabling it
    ; TIP: We cannot use a common variable (like 'float disableDurability') because it resets between game loads.
    if (Player.AuxVarGetFlt "*bDisableDurability")
        ; TODO: Remove event handlers
    else
        SetEventHandlerAlt "OnActorEquip", newDurabilityOnEquip 1::Player ; TODO: Check if it's recreated every time
        ; SetOnMenuCloseEventHandler newDurabilityAfterLevelUp, 0, 1027
        SetOnMenuCloseEventHandler newDurabilityAfterLevelUp, 1, 1027
    endif
End