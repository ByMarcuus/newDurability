scn newDurabilityLogicScript

ref armor
ref weapon
ref lastWeapon

float totalDR
float lastTotalDR

float durability
float divisor

int skill
int special
; FIX: Special and skills can change with armors, ingestibles, perks...
int skillCode
int armorCode
int lastSkill
int lastSpecial


; Script that modifies in-game weapon and armor durability.
Begin GameMode
	; This script can be running event after disabling the quest.
	if (Player.AuxVarGetFlt "*bDisableDurability")
		return
	endif

	; --- WEAPON ---
	set weapon to Player.GetEqObj 5

	if (weapon)
		set skillCode to GetWeaponSkill weapon

		if (skillCode == 38)
			set skill to Player.GetAV MeleeWeapons
		elseif (skillCode == 45)
			set skill to Player.GetAV Unarmed
		elseif (skillCode == 41)
			set skill to Player.GetAV SmallGuns
		elseif (skillCode == 34)
			set skill to Player.GetAV EnergyWeapons
		elseif (skillCode == 33)
			set skill to Player.GetAV BigGuns
		else
			; If the weapon uses an unhandled skill (like Explosives),
			; set skill to 100 so the weapon (in case that is not a grenade or mine) takes the least possible damage.
			set skill to 100
		endif

		if (weapon != lastWeapon || skill != lastSkill)
			set lastWeapon to weapon
			set lastSkill to skill

			set durability to (Player.AuxVarGetFlt "*fWeaponBaseHealth") + (((100 - skill) / 100) * (Player.AuxVarGetFlt "*fWeaponSkillMult"))
			dbprintc "Weapon durability: %.5f", durability

			set divisor to GetDamage weapon
			if (divisor <= 0)
				set divisor to 1
			endif

			set durability to durability / divisor ; BUG: Float loss precision

			; FIX: Energy 'Small Gun'-like
			; Establishes the durability for all types of weapons.
			; This is done because it seems that some weapons are not attached into the correct 'fDamage*' variable (like Plasma Rifle).
			SetNumericGameSetting "fDamageToWeaponGunMult", durability
			SetNumericGameSetting "fDamageToWeaponEnergyMult", durability
			SetNumericGameSetting "fDamageToWeaponMeleeMult", durability
			SetNumericGameSetting "fDamageToWeaponLauncherMult", durability
		endif
	endif

	; --- ARMOR ---
	set armor to Player.GetEqObj 2 ; Upper Body Piece
	set totalDR to Player.GetAV DamageResist

	if (armor)
		set armorCode to GetWeight armor
	else
		set armorCode to 0
	endif

	; Specials can change with chems and perks, so we need to check them every time.
	; TODO: Search a better way to determine which special to use for armor durability.
	if (IsPA armor || armorCode >= 25)
		set special to Player.GetAV Strength
	elseif (armorCode >= 15)
		set special to Player.GetAV Endurance
	else
		set special to Player.GetAV Agility
	endif

	if (totalDR != lastTotalDR || special != lastSpecial)
		set lastTotalDR to totalDR
		set lastSpecial to special

		set durability to (Player.AuxVarGetFlt "*fArmorBaseHealth") + (((10 - special) / 10) * (Player.AuxVarGetFlt "*fArmorSkillMult"))
		dbprintc "Armor durability: %.5f", durability

		set divisor to totalDR
		if (divisor <= 0)
			set divisor to 1
		endif
		set durability to durability / divisor ; BUG: Float loss precision

		; FIX: Damage To Armor Percentage: Make degradation scale with base DR (armor), not total DR (armor + chems + modifiers).
		; Author: DannyWithThaPhanny
		set durability to ((Player.GetBaseAV DamageResist * 0.01) / (totalDR * 0.01 + 0.0001)) * durability

		SetNumericGameSetting "fDamageToArmorPercentage", durability
	endif
End