scn newDurabilityOnGameLoad

int index
int playableFlag
int overrideFlag
short disableDurability

ref weapon

Begin Function { disableDurability }
    PrintD "NewDurability: Disabling 'Override DamageToWeaponMult' Flag..."
    GetLoadedType newDurabilityList, 40

    let index := ListGetCount newDurabilityList
    while (index -= 1) >= 0
        let weapon := ListGetNthForm newDurabilityList, index
        ListRemoveNthForm newDurabilityList, index

        let playableFlag := GetWeaponFlags1 weapon
        let overrideFlag := GetWeaponFlags2 weapon ; 'Override DamageToWeaponMult' flag
        if eval (GetBit overrideFlag, 7 && !(IsQuestItem weapon) && !(GetBit playableFlag, 7))
            SetWeaponFlags2 weapon, (overrideFlag - 128)
        endif
    loop

    if eval (!disableDurability)
        SetEventHandlerAlt "OnActorEquip", newDurabilityOnEquip 1::Player ; TODO: Check if it's recreated every time
        ; SetOnMenuCloseEventHandler newDurabilityAfterLevelUp, 0, 1027
        SetOnMenuCloseEventHandler newDurabilityAfterLevelUp, 1, 1027
    endif
End